{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "treelight",
  "account_id": "63b8e64f90bbe4f59a59706725d32033",
  "main": "./worker.ts",
  "compatibility_date": "2026-07-28",
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "routes": [
    {
      "pattern": "treelight.dzx.cz",
      "custom_domain": true
    }
  ]
}