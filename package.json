{
  "name": "treelight",
  "private": true,
  "description": "Tree-sitter based syntax highlighter.",
  "version": "0.0.2",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/astro",
    "packages/browser",
    "packages/core",
    "packages/hast",
    "packages/integration",
    "packages/rehype",
    "packages/remark",
    "packages/rspress",
    "packages/languages/*",
    "packages/themes/*",
    "docs"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@changesets/cli": "^2.31.1",
    "@treelight/astro": "workspace:*",
    "@treelight/bash": "workspace:*",
    "@treelight/browser": "workspace:*",
    "@treelight/c": "workspace:*",
    "@treelight/cpp": "workspace:*",
    "@treelight/css": "workspace:*",
    "@treelight/dockerfile": "workspace:*",
    "@treelight/ecma": "workspace:*",
    "@treelight/elixir": "workspace:*",
    "@treelight/go": "workspace:*",
    "@treelight/graphql": "workspace:*",
    "@treelight/hast": "workspace:*",
    "@treelight/html": "workspace:*",
    "@treelight/java": "workspace:*",
    "@treelight/javascript": "workspace:*",
    "@treelight/json": "workspace:*",
    "@treelight/lua": "workspace:*",
    "@treelight/markdown": "workspace:*",
    "@treelight/php": "workspace:*",
    "@treelight/python": "workspace:*",
    "@treelight/rehype": "workspace:*",
    "@treelight/remark": "workspace:*",
    "@treelight/rspress": "workspace:*",
    "@treelight/ruby": "workspace:*",
    "@treelight/rust": "workspace:*",
    "@treelight/scheme": "workspace:*",
    "@treelight/sql": "workspace:*",
    "@treelight/theme-ayu-dark": "workspace:*",
    "@treelight/theme-catppuccin-mocha": "workspace:*",
    "@treelight/theme-dracula": "workspace:*",
    "@treelight/theme-everforest-dark": "workspace:*",
    "@treelight/theme-github-dark": "workspace:*",
    "@treelight/theme-github-light": "workspace:*",
    "@treelight/theme-gruvbox": "workspace:*",
    "@treelight/theme-gruvbox-material": "workspace:*",
    "@treelight/theme-kanagawa": "workspace:*",
    "@treelight/theme-nord": "workspace:*",
    "@treelight/theme-onedark": "workspace:*",
    "@treelight/theme-rose-pine": "workspace:*",
    "@treelight/theme-solarized-light": "workspace:*",
    "@treelight/theme-tokyonight": "workspace:*",
    "@treelight/toml": "workspace:*",
    "@treelight/tsx": "workspace:*",
    "@treelight/typescript": "workspace:*",
    "@treelight/yaml": "workspace:*",
    "@treelight/zig": "workspace:*",
    "tiny-benchy": "^2.1.0",
    "turbo": "^2.10.7",
    "publint": "^0.3.22"
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "turbo run build",
    "build:core": "npm run --workspace=@treelight/core build",
    "build:watch": "npm run --workspace=@treelight/core build:watch",
    "inspect": "npm run --workspace=@treelight/core inspect",
    "tsc": "npm run --workspace=@treelight/core tsc",
    "test": "turbo run test",
    "test:update": "turbo run test -- --update-snapshots",
    "prebench": "npm run build",
    "bench": "node bench.js",
    "lint": "turbo run lint",
    "lint:repo": "biome ci --diagnostic-level=error --reporter=github",
    "lint:fix": "biome check --write",
    "check:languages": "node ./scripts/check-language-metadata.mjs",
    "create:language": "node ./scripts/create-language-package.mjs",
    "create:theme": "node ./scripts/create-theme-package.mjs",
    "list:public-packages": "node ./scripts/list-public-packages.mjs",
    "publish:initial": "node ./scripts/publish-initial-packages.mjs",
    "trust:packages": "node ./scripts/setup-trusted-publishing.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "packageManager": "npm@11.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matoous/treelight.git"
  }
}
