{
  "name": "@treelight/bash",
  "version": "0.2.0",
  "description": "Treelight language module for bash.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matoous/treelight.git"
  },
  "keywords": [
    "treelight",
    "tree-sitter",
    "language",
    "bash"
  ],
  "scripts": {
    "build": "rslib build && cp dist/index.d.cts dist/index.d.mts && publint",
    "build:watch": "rslib build --watch",
    "inspect": "rslib inspect",
    "tsc": "tsc --noEmit",
    "lint": "biome ci --diagnostic-level=error --reporter=github",
    "update": "node ../../../scripts/update-language-wasm.mjs"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "publint": "^0.3.22"
  },
  "treelightLanguage": {
    "repo": "tree-sitter/tree-sitter-bash",
    "revision": "a06c2e4415e9bc0346c6b86d401879ffb44058f7",
    "version": "a06c2e4415e9bc0346c6b86d401879ffb44058f7",
    "artifact": "tree-sitter-bash.wasm",
    "source": {
      "git": "https://github.com/tree-sitter/tree-sitter-bash.git"
    },
    "queries": {
      "highlights": [
        "queries/highlights.scm"
      ],
      "injections": [
        "queries/injections.scm"
      ],
      "locals": [
        "queries/locals.scm"
      ]
    }
  },
  "engines": {
    "node": ">= 18"
  }
}
