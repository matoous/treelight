{
  "name": "@treelight/tsx",
  "version": "0.0.2",
  "description": "Treelight language module for tsx.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matoous/treelight.git"
  },
  "keywords": [
    "treelight",
    "tree-sitter",
    "language",
    "tsx"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "build:watch": "rslib build --watch",
    "inspect": "rslib inspect",
    "tsc": "tsc --noEmit",
    "lint": "biome ci --diagnostic-level=error --reporter=github",
    "lint:fix": "biome check --write",
    "update": "node ../../../scripts/update-language-wasm.mjs"
  },
  "dependencies": {
    "@treelight/ecma": "0.0.2"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.1.2",
    "rsbuild-plugin-publint": "^1.0.0",
    "typescript": "^7.0.2"
  },
  "treelightLanguage": {
    "repo": "tree-sitter/tree-sitter-typescript",
    "revision": "v0.23.2",
    "version": "v0.23.2",
    "artifact": "tree-sitter-tsx.wasm",
    "grammarPath": "tsx",
    "queries": {
      "highlights": [
        "tsx/queries/highlights.scm"
      ],
      "injections": [
        "tsx/queries/injections.scm"
      ],
      "locals": [
        "typescript/queries/locals.scm"
      ]
    },
    "querySources": {
      "sharedHighlights": {
        "package": "@treelight/ecma"
      },
      "typescriptHighlights": {
        "path": "../typescript/src/queries/highlights.scm"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
