{
  "name": "@treelight/lua",
  "version": "0.2.0",
  "description": "Treelight language module for lua.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matoous/treelight.git"
  },
  "keywords": [
    "treelight",
    "tree-sitter",
    "language",
    "lua"
  ],
  "scripts": {
    "build": "rslib build",
    "build:watch": "rslib build --watch",
    "inspect": "rslib inspect",
    "tsc": "tsc --noEmit",
    "lint": "biome ci --diagnostic-level=error --reporter=github",
    "update": "node ../../../scripts/update-language-wasm.mjs"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.1.2",
    "rsbuild-plugin-publint": "^1.0.0",
    "typescript": "^7.0.2"
  },
  "treelightLanguage": {
    "repo": "tree-sitter-grammars/tree-sitter-lua",
    "revision": "10fe0054734eec83049514ea2e718b2a56acd0c9",
    "version": "10fe0054734eec83049514ea2e718b2a56acd0c9",
    "artifact": "tree-sitter-lua.wasm",
    "source": {
      "git": "https://github.com/tree-sitter-grammars/tree-sitter-lua.git"
    },
    "queries": {
      "highlights": [
        "queries/highlights.scm"
      ],
      "injections": [
        "queries/injections.scm"
      ],
      "locals": [
        "queries/locals.scm"
      ]
    }
  }
}
