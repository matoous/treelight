{
  "name": "@treelight/ecma",
  "version": "0.1.0",
  "description": "Shared ECMAScript highlight queries for Treelight languages.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matoous/treelight.git"
  },
  "keywords": [
    "treelight",
    "tree-sitter",
    "language",
    "ecma"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "build:watch": "rslib build --watch",
    "inspect": "rslib inspect",
    "tsc": "tsc --noEmit",
    "lint": "biome ci --diagnostic-level=error --reporter=github"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.1.2",
    "rsbuild-plugin-publint": "^1.0.0",
    "typescript": "^7.0.2"
  },
  "treelightLanguage": {
    "repo": "helix-editor/helix",
    "revision": "master",
    "queries": {
      "highlights": [
        "runtime/queries/ecma/highlights.scm"
      ]
    },
    "notes": "Shared ECMAScript query layer adapted from Helix runtime queries."
  },
  "publishConfig": {
    "access": "public"
  }
}
