{
  "name": "@treelight/php",
  "version": "0.0.2",
  "description": "Treelight language module for php.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matoous/treelight.git"
  },
  "keywords": [
    "treelight",
    "tree-sitter",
    "language",
    "php"
  ],
  "scripts": {
    "build": "rslib build",
    "build:watch": "rslib build --watch",
    "inspect": "rslib inspect",
    "tsc": "tsc --noEmit",
    "lint": "biome ci --diagnostic-level=error --reporter=github",
    "update": "node ../../../scripts/update-language-wasm.mjs"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.1.2",
    "rsbuild-plugin-publint": "^1.0.0",
    "typescript": "^7.0.2"
  },
  "treelightLanguage": {
    "repo": "tree-sitter/tree-sitter-php",
    "version": "v0.24.2",
    "artifact": "tree-sitter-php.wasm"
  }
}
