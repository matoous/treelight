---
import {
  type CreateHighlighterOptions,
  createHighlighter,
  type Highlighter,
  type HighlightOptions,
} from '@treelight/core';
import {
  addClassName,
  applyCodeBlockLineOptions,
  type CopyButtonOption,
  type HighlightLinesOption,
  hastToHtml,
  htmlFragmentToNodes,
  type LineNumbersOption,
  resolveCopyButton,
  resolveHighlightedLines,
  resolveLineNumbers,
  resolveTheme,
  resolveTitle,
  wrapCodeBlockCopyButton,
  wrapCodeBlockFrame,
} from '@treelight/hast';
import type { Root } from 'hast';

export interface Props extends CreateHighlighterOptions {
  class?: string;
  code: string;
  copyButton?: CopyButtonOption;
  highlighter?: Highlighter | Promise<Highlighter>;
  highlightLines?: HighlightLinesOption;
  lang?: string;
  language?: string;
  languageMap?: Record<string, string>;
  lineNumbers?: LineNumbersOption;
  meta?: string;
  title?: string;
}

const {
  class: className,
  code,
  copyButton,
  highlighter,
  highlightLines,
  lang,
  language: languageProp,
  languageMap,
  lineNumbers,
  meta = '',
  title,
  ...highlighterOptions
} = Astro.props;

const requestedLanguage = languageProp || lang || 'text';
const language = languageMap?.[requestedLanguage] || requestedLanguage;
const resolvedHighlighter = await Promise.resolve(
  highlighter || createHighlighter(highlighterOptions),
);
const html = await resolvedHighlighter.highlight(code, language, {
  ...(highlighterOptions as HighlightOptions),
  theme: resolveTheme(highlighterOptions.theme, meta),
});
const renderedNodes = htmlFragmentToNodes(html);
const renderedPreIndex = renderedNodes.findIndex(
  (child) => child.type === 'element' && child.tagName === 'pre',
);
const renderedPre = renderedNodes[renderedPreIndex];

if (renderedPre?.type === 'element') {
  addClassName(renderedPre, `language-${language}`);
  for (const name of className?.split(/\s+/g).filter(Boolean) ?? []) {
    addClassName(renderedPre, name);
  }
  applyCodeBlockLineOptions(renderedPre, {
    highlightedLines: resolveHighlightedLines(highlightLines, meta),
    lineNumbers: resolveLineNumbers(lineNumbers, meta),
  });
  const renderedBlock = wrapCodeBlockFrame(renderedPre, {
    title: resolveTitle(title, meta),
  });
  renderedNodes[renderedPreIndex] = wrapCodeBlockCopyButton(
    renderedBlock,
    resolveCopyButton(copyButton, meta),
  );
}

// biome-ignore lint/correctness/noUnusedVariables: Astro consumes this value in the template below.
const renderedHtml = hastToHtml({
  type: 'root',
  children: renderedNodes,
} satisfies Root);
---

<Fragment set:html={renderedHtml} />
