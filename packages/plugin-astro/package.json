{
  "name": "@treelight/plugin-astro",
  "version": "0.0.1",
  "description": "Astro integration for rendering code blocks with Treelight.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./components/Code.astro": "./components/Code.astro",
    "./styles.css": "./styles.css"
  },
  "files": [
    "components",
    "dist",
    "styles.css"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matoous/treelight.git"
  },
  "engines": {
    "node": ">= 18"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "treelight",
    "syntax-highlighting",
    "code-blocks"
  ],
  "scripts": {
    "build": "rslib build && cp dist/index.d.cts dist/index.d.mts && publint",
    "build:watch": "rslib build --watch",
    "inspect": "rslib inspect",
    "tsc": "tsc --noEmit",
    "lint": "biome ci --diagnostic-level=error --reporter=github"
  },
  "dependencies": {
    "@treelight/core": "0.4.1",
    "@treelight/hast": "0.4.1",
    "@treelight/plugin-rehype": "0.0.1"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.1.2",
    "astro": "^7.1.4",
    "typescript": "^7.0.2",
    "publint": "^0.3.22"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
