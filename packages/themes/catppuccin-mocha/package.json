{
  "name": "@treelight/theme-catppuccin-mocha",
  "version": "0.3.0",
  "description": "Treelight theme module for catppuccin-mocha.",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matoous/treelight.git"
  },
  "keywords": [
    "treelight",
    "tree-sitter",
    "theme",
    "catppuccin-mocha"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "rslib build && cp dist/index.d.cts dist/index.d.mts && publint",
    "build:watch": "rslib build --watch",
    "inspect": "rslib inspect",
    "tsc": "tsc --noEmit",
    "lint": "biome ci --diagnostic-level=error --reporter=github"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "publint": "^0.3.22"
  },
  "publishConfig": {
    "access": "public"
  },
  "treelightTheme": {
    "upstream": {
      "name": "Catppuccin for Helix",
      "url": "https://github.com/catppuccin/helix",
      "license": "MIT"
    },
    "helix": {
      "source": "runtime/themes/catppuccin_mocha.toml"
    }
  },
  "engines": {
    "node": ">= 18"
  }
}
