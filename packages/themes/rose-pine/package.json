{
  "name": "@treelight/theme-rose-pine",
  "version": "0.0.1",
  "description": "Treelight theme module for rose-pine.",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matoous/treelight.git"
  },
  "keywords": [
    "treelight",
    "tree-sitter",
    "theme",
    "rose-pine"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "rslib build",
    "build:watch": "rslib build --watch",
    "inspect": "rslib inspect",
    "tsc": "tsc --noEmit",
    "lint": "biome ci --diagnostic-level=error --reporter=github"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.1.2",
    "rsbuild-plugin-publint": "^1.0.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "treelightTheme": {
    "upstream": {
      "name": "Rose Pine for Helix",
      "url": "https://github.com/rose-pine/helix",
      "license": "MIT"
    },
    "helix": {
      "source": "runtime/themes/rose_pine.toml"
    }
  }
}
