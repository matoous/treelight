{
  "name": "@treelight/catalog",
  "version": "0.5.0",
  "description": "Lazy language catalog and file resolver for Treelight.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matoous/treelight.git"
  },
  "scripts": {
    "build": "rslib build && cp dist/index.d.cts dist/index.d.mts && publint",
    "build:watch": "rslib build --watch",
    "inspect": "rslib inspect",
    "tsc": "tsc --noEmit",
    "lint": "biome ci --diagnostic-level=error --reporter=github"
  },
  "dependencies": {
    "@treelight/astro": "0.5.0",
    "@treelight/awk": "0.5.0",
    "@treelight/bash": "0.5.0",
    "@treelight/c": "0.5.0",
    "@treelight/c-sharp": "0.5.0",
    "@treelight/clojure": "0.5.0",
    "@treelight/comment": "0.5.0",
    "@treelight/core": "0.5.0",
    "@treelight/cpp": "0.5.0",
    "@treelight/css": "0.5.0",
    "@treelight/dart": "0.5.0",
    "@treelight/dockerfile": "0.5.0",
    "@treelight/elixir": "0.5.0",
    "@treelight/erb": "0.5.0",
    "@treelight/fish": "0.5.0",
    "@treelight/go": "0.5.0",
    "@treelight/go-format-string": "0.5.0",
    "@treelight/graphql": "0.5.0",
    "@treelight/haskell": "0.5.0",
    "@treelight/hcl": "0.5.0",
    "@treelight/heex": "0.5.0",
    "@treelight/html": "0.5.0",
    "@treelight/java": "0.5.0",
    "@treelight/javascript": "0.5.0",
    "@treelight/jq": "0.5.0",
    "@treelight/jsdoc": "0.5.0",
    "@treelight/json": "0.5.0",
    "@treelight/kotlin": "0.5.0",
    "@treelight/latex": "0.5.0",
    "@treelight/lua": "0.5.0",
    "@treelight/lua-format-string": "0.5.0",
    "@treelight/luap": "0.5.0",
    "@treelight/markdown": "0.5.0",
    "@treelight/markdown-inline": "0.5.0",
    "@treelight/nginx": "0.5.0",
    "@treelight/nim": "0.5.0",
    "@treelight/nix": "0.5.0",
    "@treelight/nu": "0.5.0",
    "@treelight/perl": "0.5.0",
    "@treelight/php": "0.5.0",
    "@treelight/phpdoc": "0.5.0",
    "@treelight/pod": "0.5.0",
    "@treelight/powershell": "0.5.0",
    "@treelight/protobuf": "0.5.0",
    "@treelight/python": "0.5.0",
    "@treelight/regex": "0.5.0",
    "@treelight/ruby": "0.5.0",
    "@treelight/rust": "0.5.0",
    "@treelight/scheme": "0.5.0",
    "@treelight/scss": "0.5.0",
    "@treelight/sql": "0.5.0",
    "@treelight/svelte": "0.5.0",
    "@treelight/swift": "0.5.0",
    "@treelight/toml": "0.5.0",
    "@treelight/tsx": "0.5.0",
    "@treelight/typescript": "0.5.0",
    "@treelight/vue": "0.5.0",
    "@treelight/xml": "0.5.0",
    "@treelight/yaml": "0.5.0",
    "@treelight/zig": "0.5.0"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.1.2",
    "publint": "^0.3.22",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 18"
  }
}
