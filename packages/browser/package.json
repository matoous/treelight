{
  "name": "@treelight/browser",
  "version": "0.2.0",
  "description": "Browser helpers for Treelight.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matoous/treelight.git"
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "rslib build",
    "build:watch": "rslib build --watch",
    "inspect": "rslib inspect",
    "tsc": "tsc --noEmit",
    "lint": "biome ci --diagnostic-level=error --reporter=github"
  },
  "dependencies": {
    "@treelight/core": "0.2.0",
    "web-tree-sitter": "^0.26.11"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.1.2",
    "rsbuild-plugin-publint": "^1.0.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
